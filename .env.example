# =============================================================================
# AI JOB APPLICATION AGENT — environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Required to boot:  AUTH_SECRET, AUTH_PASSWORD_HASH (or AUTH_PASSWORD), DATABASE_URL
# Required to think: at least one AI provider (Anthropic, OpenAI, or Ollama)
# Everything else is optional and degrades gracefully when unset.
# =============================================================================

# ─── Authentication (REQUIRED) ───────────────────────────────────────────────
# Signs the session JWT. Must be >= 32 characters. There is no built-in default:
# the app refuses to start a session without it.
#   Generate:  openssl rand -base64 48
AUTH_SECRET=

# Dashboard password. Prefer the bcrypt hash — a leaked .env then yields no
# directly reusable password.
#   Generate:  npm run auth:hash
AUTH_PASSWORD_HASH=
# Plaintext fallback (compared in constant time). Leave blank if using the hash.
AUTH_PASSWORD=

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/job_agent"

# Used by docker-compose to provision Postgres. Keep in sync with DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=job_agent

# Log every SQL query (noisy — debugging only).
PRISMA_LOG_QUERIES=false

# ─── AI providers ────────────────────────────────────────────────────────────
# Which provider to use: anthropic | openai | ollama
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local, no-API-key inference. Point at an OpenAI-compatible Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ─── Résumé configuration ────────────────────────────────────────────────────
# Your canonical résumé facts live in `config/resume.json` (gitignored). Start
# from the committed template:
#   cp config/resume.example.json config/resume.json
# Override the location here if you keep it elsewhere.
RESUME_CONFIG_PATH=

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PATH=./applications
RESUMES_PATH=./applications/resumes
LOGS_PATH=./logs

# Encryption key for credentials at rest (AES-256-GCM). Auto-generated into
# ~/.job-agent-tools/secret.key on first use; set explicitly for CI/containers.
#   Generate:  openssl rand -base64 32
JOB_AGENT_SECRET_KEY=
JOB_AGENT_KEY_PATH=

# ─── PDF compilation ─────────────────────────────────────────────────────────
# Path to the Tectonic binary. Falls back to ~/.job-agent-tools/tectonic, then PATH.
TECTONIC_PATH=

# Overleaf (optional alternative to local LaTeX compilation).
OVERLEAF_EMAIL=
OVERLEAF_PASSWORD=
OVERLEAF_PROJECT_ID=

# ─── Job sources ─────────────────────────────────────────────────────────────
# LinkedIn session cookie (the `li_at` value) — safer than storing credentials.
LINKEDIN_COOKIE=

# Minimum gap between requests to the same host, in ms. Be polite; raise it if
# a source starts rate-limiting you.
SCRAPER_DOMAIN_GAP_MS=1100

# ─── GitHub project import ───────────────────────────────────────────────────
# Default account to scan for portfolio projects.
GITHUB_USERNAME=
# Exposed to the browser to prefill the dashboard field. Not a secret.
NEXT_PUBLIC_GITHUB_USERNAME=
# Personal access token (public_repo scope) — raises the API rate limit.
GITHUB_TOKEN=

# ─── Gmail integration (optional, read-only OAuth) ───────────────────────────
# Auto-fetches application OTP/verification codes during apply and scans incoming
# mail to update application statuses.
#   1. console.cloud.google.com -> create a project
#   2. APIs & Services -> enable the "Gmail API"
#   3. OAuth consent screen -> External; add your Gmail as a Test user
#   4. Credentials -> Create OAuth client ID -> "Web application"
#      Authorized redirect URI: http://localhost:3000/api/gmail/oauth/callback
#   5. Paste below, then click "Connect Gmail" in the app.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT=http://localhost:3000/api/gmail/oauth/callback

# ─── Job search preferences ──────────────────────────────────────────────────
JOB_SEARCH_KEYWORDS=Software Engineer,Frontend Engineer,Backend Engineer,Full Stack Engineer
JOB_SEARCH_LOCATIONS=Remote,New York,San Francisco
JOB_SEARCH_REMOTE=true
JOB_REQUIRE_SPONSORSHIP=false
JOB_EXPERIENCE_LEVELS=entry,mid
JOB_MIN_SALARY=80000

# Comma-separated company filters.
BLACKLIST_COMPANIES=
PREFERRED_COMPANIES=

# ─── Automation behaviour ────────────────────────────────────────────────────
# Randomised delay between actions, in ms — keeps the automation human-paced.
AUTOMATION_DELAY_MIN=2000
AUTOMATION_DELAY_MAX=8000
AUTOMATION_MAX_APPLICATIONS_PER_DAY=30
# Leave AUTO_APPLY off and APPROVAL on until you trust the output.
AUTOMATION_AUTO_APPLY=false
AUTOMATION_REQUIRE_APPROVAL=true

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NEXTAUTH_URL=http://localhost:3000
