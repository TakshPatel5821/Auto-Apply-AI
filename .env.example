# ============================================
# AI JOB APPLICATION AGENT - Environment Config
# ============================================

# Authentication
AUTH_PASSWORD=your_secure_password_here
AUTH_SECRET=your_64_char_random_secret_here_change_this_in_production

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/job_agent"

# AI APIs
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# Preferred AI Model
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# Application Storage
STORAGE_PATH=./applications
RESUMES_PATH=./applications/resumes
LOGS_PATH=./logs

# Overleaf (Optional - for LaTeX resume automation)
OVERLEAF_EMAIL=your_overleaf_email
OVERLEAF_PASSWORD=your_overleaf_password
OVERLEAF_PROJECT_ID=your_project_id

# LinkedIn (Cookie-based session - safer than credentials)
LINKEDIN_COOKIE=your_linkedin_li_at_cookie

# Gmail Integration (OAuth2, read-only) — auto-fetch application OTP/verification
# codes during apply, and live-scan incoming mail to update application statuses.
# One-time Google setup:
#   1. console.cloud.google.com -> create a project
#   2. APIs & Services -> enable the "Gmail API"
#   3. OAuth consent screen -> External; add your Gmail as a Test user
#   4. Credentials -> Create OAuth client ID -> "Web application"
#      Authorized redirect URI: http://localhost:3000/api/gmail/oauth/callback
#   5. Paste the client ID + secret below, then click "Connect Gmail" in the app.
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_OAUTH_REDIRECT=http://localhost:3000/api/gmail/oauth/callback

# Job Search Settings
JOB_SEARCH_KEYWORDS=Software Engineer,Frontend Engineer,Backend Engineer,Full Stack Engineer
JOB_SEARCH_LOCATIONS=Remote,New York,San Francisco
JOB_SEARCH_REMOTE=true
JOB_REQUIRE_SPONSORSHIP=false
JOB_EXPERIENCE_LEVELS=entry,mid
JOB_MIN_SALARY=80000

# Automation Settings
AUTOMATION_DELAY_MIN=2000
AUTOMATION_DELAY_MAX=8000
AUTOMATION_MAX_APPLICATIONS_PER_DAY=30
AUTOMATION_AUTO_APPLY=false
AUTOMATION_REQUIRE_APPROVAL=true

# Blacklisted Companies (comma-separated)
BLACKLIST_COMPANIES=

# Preferred Companies (comma-separated)
PREFERRED_COMPANIES=

# Server
NEXTAUTH_URL=http://localhost:3000
PORT=3000
