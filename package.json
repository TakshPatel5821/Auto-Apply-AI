{
  "name": "ai-job-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Single-user, local-first AI job-application agent: scrapes jobs, scores them against your r\u00e9sum\u00e9, tailors truthful r\u00e9sum\u00e9s and cover letters, and auto-applies across 13+ ATS platforms with a human-in-the-loop safety net.",
  "keywords": [
    "job-search",
    "ats",
    "resume",
    "automation",
    "playwright",
    "nextjs",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TakshPatel5821/Auto-Apply-AI.git"
  },
  "bugs": {
    "url": "https://github.com/TakshPatel5821/Auto-Apply-AI/issues"
  },
  "homepage": "https://github.com/TakshPatel5821/Auto-Apply-AI#readme",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "agent": "tsx scripts/agent-cli.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "next": "^15.5.22",
    "openai": "^4.71.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "linkedom": "^0.18.12",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "sharp": "^0.35.3",
    "dompurify": "^3.4.12",
    "postcss": "^8.5.24"
  }
}
